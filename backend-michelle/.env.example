# Anti-bot Cloudflare Turnstile (obligatorio en producción)
TURNSTILE_SECRET_KEY=

# Correo (Resend): pautas PDF, confirmaciones, recordatorios y recuperación de contraseña.
# Sin RESEND_API_KEY los correos no se envían (la app sigue funcionando).
