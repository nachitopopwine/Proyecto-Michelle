PORT=3000
MONGODB_URI=mongodb://localhost:27017/michelle
# Obligatorio en producción (mínimo 32 caracteres). Generar con: openssl rand -hex 32
JWT_SECRET=change-this-in-production
# URL pública del frontend (CORS y enlaces de los correos). Varias separadas por coma.
FRONTEND_URL=http://localhost:3001
TIME_ZONE=America/Santiago

# Cuenta de Michelle: se crea al arrancar si no existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Michelle Morales

# Anti-bot Cloudflare Turnstile (obligatorio en producción)
TURNSTILE_SECRET_KEY=

# Correo (Resend): pautas PDF, confirmaciones, recordatorios y recuperación de contraseña.
# Sin RESEND_API_KEY los correos no se envían (la app sigue funcionando).
RESEND_API_KEY=
MAIL_FROM=Michelle Morales Nutrición <agenda@tu-dominio.cl>

# Google Calendar (opcional): cuenta de servicio con acceso de edición al calendario
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
